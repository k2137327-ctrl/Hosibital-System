@{
    ViewData["Title"] = "Home Page";
}

<div class="container text-center py-5">
    <div class="p-5 mb-4 bg-light rounded-4 shadow-sm border">
        <h1 class="display-4 fw-bold text-primary mb-3">Welcome to Care Hospital</h1>
        <p class="fs-5 text-muted mb-4">Book your appointment with our best specialized doctors easily and quickly.</p>

        <div class="d-flex justify-content-center gap-3">
             
            <a asp-controller="Hospital" asp-action="Doctors" class="btn btn-primary btn-lg px-4 shadow-sm">
                Make Appointment
            </a>

             
            <a asp-controller="Hospital" asp-action="Appointments" class="btn btn-outline-secondary btn-lg px-4">
                View Appointments
            </a>
        </div>
    </div>
</div>